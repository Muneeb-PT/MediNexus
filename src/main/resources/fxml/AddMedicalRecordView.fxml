<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.AddMedicalRecordController">

    <top>

        <VBox spacing="8"
              styleClass="dashboard-content">

            <Label text="Add Medical Record"
                   styleClass="section-title"/>

            <Label fx:id="patientLabel"
                   text="Patient: -"/>

            <Label fx:id="doctorLabel"
                   text="Doctor: -"/>

        </VBox>

    </top>


    <center>

        <VBox spacing="20"
              styleClass="dashboard-content">

            <GridPane hgap="15"
                      vgap="15">

                <Label text="Appointment:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="appointmentComboBox"
                          prefWidth="350"
                          promptText="Select appointment"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"/>


                <Label text="Symptoms:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextArea fx:id="symptomsField"
                          prefRowCount="3"
                          promptText="Enter patient symptoms"
                          wrapText="true"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>


                <Label text="Diagnosis:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextArea fx:id="diagnosisField"
                          prefRowCount="3"
                          promptText="Enter diagnosis"
                          wrapText="true"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"/>


                <Label text="Treatment:"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <TextArea fx:id="treatmentField"
                          prefRowCount="3"
                          promptText="Enter treatment"
                          wrapText="true"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1"/>


                <Label text="Notes:"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <TextArea fx:id="notesField"
                          prefRowCount="4"
                          promptText="Additional medical notes"
                          wrapText="true"
                          GridPane.rowIndex="4"
                          GridPane.columnIndex="1"/>

            </GridPane>


            <HBox spacing="10">

                <Button text="Save Medical Record"
                        onAction="#handleSave"/>

                <Button text="Clear"
                        onAction="#handleClear"/>

                <Button text="Cancel"
                        onAction="#handleCancel"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>