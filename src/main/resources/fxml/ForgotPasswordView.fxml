<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.ForgotPasswordController">

    <center>

        <VBox alignment="CENTER"
              maxWidth="500"
              spacing="18"
              style="-fx-background-color: white;
                     -fx-padding: 45;">

            <Label text="Forgot Password"
                   style="-fx-font-size: 30px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #172554;"/>

            <Label text="Enter your MediNexus username to begin password recovery."
                   wrapText="true"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #64748b;"/>

            <TextField fx:id="usernameField"
                       promptText="Username"
                       prefHeight="45"/>

            <Button text="Continue"
                    onAction="#handleRequestReset"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   style="-fx-text-fill: #475569;
                          -fx-font-size: 13px;"/>

            <Button text="Back to Login"
                    onAction="#handleBackToLogin"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #2563eb;
                           -fx-font-weight: bold;"/>

        </VBox>

    </center>

</BorderPane>