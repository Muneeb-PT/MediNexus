<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.SignupController"
            style="-fx-background-color: #f5f7fb;">

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent;">

            <content>

                <VBox alignment="TOP_CENTER"
                      spacing="20"
                      maxWidth="720"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-padding: 35;">

                    <Label text="Create Patient Account"
                           style="-fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #172033;"/>

                    <Label text="Register securely with MediNexus"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #667085;"/>

                    <GridPane hgap="18"
                              vgap="16">

                        <padding>
                            <Insets top="15"
                                    right="5"
                                    bottom="5"
                                    left="5"/>
                        </padding>

                        <Label text="Username"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="usernameField"
                                   promptText="Choose a username"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="1"/>

                        <Label text="Full Name"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="fullNameField"
                                   promptText="Enter your full name"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="Age"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="ageField"
                                   promptText="Enter age"
                                   GridPane.rowIndex="2"
                                   GridPane.columnIndex="1"/>

                        <Label text="Gender"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="0"/>

                        <ComboBox fx:id="genderComboBox"
                                  promptText="Select gender"
                                  maxWidth="Infinity"
                                  GridPane.rowIndex="3"
                                  GridPane.columnIndex="1"/>

                        <Label text="Phone"
                               GridPane.rowIndex="4"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="phoneField"
                                   promptText="Enter phone number"
                                   GridPane.rowIndex="4"
                                   GridPane.columnIndex="1"/>

                        <Label text="Blood Group"
                               GridPane.rowIndex="5"
                               GridPane.columnIndex="0"/>

                        <ComboBox fx:id="bloodGroupComboBox"
                                  promptText="Select blood group"
                                  maxWidth="Infinity"
                                  GridPane.rowIndex="5"
                                  GridPane.columnIndex="1"/>

                        <Label text="Password"
                               GridPane.rowIndex="6"
                               GridPane.columnIndex="0"/>

                        <PasswordField fx:id="passwordField"
                                       promptText="Strong password required"
                                       GridPane.rowIndex="6"
                                       GridPane.columnIndex="1"/>
                        <Label text="Use 8+ characters with uppercase, lowercase, number and special character."
                               wrapText="true"
                               style="-fx-font-size: 11px;
              -fx-text-fill: #667085;"
                               GridPane.rowIndex="6"
                               GridPane.columnIndex="1"/>

                        <Label text="Confirm Password"
                               GridPane.rowIndex="7"
                               GridPane.columnIndex="0"/>

                        <PasswordField fx:id="confirmPasswordField"
                                       promptText="Re-enter password"
                                       GridPane.rowIndex="7"
                                       GridPane.columnIndex="1"/>

                    </GridPane>

                    <Label fx:id="messageLabel"
                           wrapText="true"
                           style="-fx-text-fill: #c0392b;
                                  -fx-font-size: 13px;"/>

                    <HBox alignment="CENTER"
                          spacing="15">

                        <Button text="Create Account"
                                onAction="#handleSignup"
                                style="-fx-background-color: #2563eb;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-padding: 10 25;
                                       -fx-background-radius: 8;"/>

                        <Button text="Back to Login"
                                onAction="#handleBackToLogin"
                                style="-fx-padding: 10 25;
                                       -fx-background-radius: 8;"/>

                    </HBox>

                    <Label text="Patient registration only • MediNexus"
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #98a2b3;"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>