<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.PrescriptionController">

    <top>
        <VBox spacing="8"
              styleClass="dashboard-content">

            <Label text="E-Prescriptions"
                   styleClass="section-title"/>

            <Label fx:id="patientLabel"
                   text="Patient: -"/>

            <Label fx:id="recordLabel"
                   text="Medical Record: -"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="15"
              styleClass="dashboard-content">

            <TableView fx:id="prescriptionTable"
                       prefHeight="450">

                <columns>

                    <TableColumn fx:id="prescriptionIdColumn"
                                 text="Prescription ID"
                                 prefWidth="120"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="160"/>

                    <TableColumn fx:id="medicineColumn"
                                 text="Medicine"
                                 prefWidth="160"/>

                    <TableColumn fx:id="quantityColumn"
                                 text="Quantity"
                                 prefWidth="80"/>

                    <TableColumn fx:id="dosageColumn"
                                 text="Dosage"
                                 prefWidth="120"/>

                    <TableColumn fx:id="frequencyColumn"
                                 text="Frequency"
                                 prefWidth="150"/>

                    <TableColumn fx:id="durationColumn"
                                 text="Duration"
                                 prefWidth="120"/>

                    <TableColumn fx:id="instructionsColumn"
                                 text="Instructions"
                                 prefWidth="250"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="110"/>

                </columns>

            </TableView>

            <HBox spacing="10">

                <Button text="Refresh"
                        onAction="#handleRefresh"/>

                <Button text="Dispense"
                        onAction="#handleDispense"/>

                <Button text="Generate Bill"
                        onAction="#handleGenerateBill"/>

                <Button text="Close"
                        onAction="#handleClose"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>