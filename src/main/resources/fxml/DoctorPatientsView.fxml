<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.DoctorPatientsController">

    <top>
        <VBox spacing="8"
              styleClass="dashboard-content">

            <Label text="My Patients"
                   styleClass="section-title"/>

            <Label fx:id="doctorLabel"
                   text="Doctor"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="15"
              styleClass="dashboard-content">

            <TableView fx:id="patientTable"
                       prefHeight="450">

                <columns>

                    <TableColumn fx:id="patientIdColumn"
                                 text="Patient ID"
                                 prefWidth="100"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Patient Name"
                                 prefWidth="180"/>

                    <TableColumn fx:id="ageColumn"
                                 text="Age"
                                 prefWidth="70"/>

                    <TableColumn fx:id="genderColumn"
                                 text="Gender"
                                 prefWidth="100"/>

                    <TableColumn fx:id="phoneColumn"
                                 text="Phone"
                                 prefWidth="150"/>

                    <TableColumn fx:id="bloodGroupColumn"
                                 text="Blood Group"
                                 prefWidth="110"/>

                </columns>

            </TableView>

            <HBox spacing="10">

                <Button text="Refresh"
                        onAction="#handleRefresh"/>

                <Button text="View Medical Records"
                        onAction="#handleViewRecords"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>