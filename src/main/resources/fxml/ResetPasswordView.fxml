<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.ResetPasswordController">

    <center>

        <VBox alignment="CENTER"
              maxWidth="520"
              spacing="18"
              style="-fx-background-color: white;
                     -fx-padding: 45;">

            <Label text="Reset Password"
                   style="-fx-font-size: 30px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #172554;"/>

            <Label text="Create a new secure password for your MediNexus account."
                   wrapText="true"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #64748b;"/>

            <Label fx:id="tokenLabel"
                   wrapText="true"
                   style="-fx-background-color: #eff6ff;
                          -fx-padding: 12;
                          -fx-text-fill: #1e40af;
                          -fx-font-size: 12px;"/>

            <PasswordField fx:id="newPasswordField"
                           promptText="New password"
                           prefHeight="45"/>

            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirm new password"
                           prefHeight="45"/>

            <Label text="Password must contain at least 8 characters, uppercase, lowercase, number, and special character."
                   wrapText="true"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #64748b;"/>

            <Button text="Reset Password"
                    onAction="#handleResetPassword"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   style="-fx-text-fill: #475569;
                          -fx-font-size: 13px;"/>

            <Button text="Back to Login"
                    onAction="#handleBackToLogin"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #2563eb;
                           -fx-font-weight: bold;"/>

        </VBox>

    </center>

</BorderPane>