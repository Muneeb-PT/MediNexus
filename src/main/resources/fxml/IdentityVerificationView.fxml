<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.medinexus.controller.IdentityVerificationController">

    <top>
        <VBox spacing="6">
            <padding>
                <Insets top="20" right="20" bottom="15" left="20"/>
            </padding>

            <Label
                    text="Identity Verification Review"
                    style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label
                    text="Review pending patient identity verification requests submitted through MediNexus."
                    style="-fx-text-fill: #666666;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="5" right="20" bottom="10" left="20"/>
            </padding>

            <TableView
                    fx:id="verificationTable"
                    VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn
                            fx:id="verificationIdColumn"
                            text="ID"
                            prefWidth="70"/>

                    <TableColumn
                            fx:id="patientIdColumn"
                            text="Patient ID"
                            prefWidth="90"/>

                    <TableColumn
                            fx:id="providerColumn"
                            text="Provider"
                            prefWidth="170"/>

                    <TableColumn
                            fx:id="statusColumn"
                            text="Status"
                            prefWidth="110"/>

                    <TableColumn
                            fx:id="documentTypeColumn"
                            text="Document Type"
                            prefWidth="170"/>

                    <TableColumn
                            fx:id="documentReferenceColumn"
                            text="Reference"
                            prefWidth="180"/>

                    <TableColumn
                            fx:id="verifiedAtColumn"
                            text="Verified At"
                            prefWidth="160"/>

                </columns>

                <placeholder>
                    <Label text="No pending identity verification requests."/>
                </placeholder>

            </TableView>

            <Label
                    fx:id="messageLabel"
                    text="Loading verification requests..."
                    style="-fx-text-fill: #555555;"/>
        </VBox>
    </center>

    <bottom>
        <HBox
                spacing="10"
                alignment="CENTER_RIGHT">

            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <Button
                    fx:id="refreshButton"
                    text="Refresh"
                    onAction="#handleRefresh"
                    prefWidth="100"/>

            <Button
                    fx:id="approveButton"
                    text="Approve"
                    onAction="#handleApprove"
                    prefWidth="110"
                    style="-fx-font-weight: bold;"/>

            <Button
                    fx:id="rejectButton"
                    text="Reject"
                    onAction="#handleReject"
                    prefWidth="110"/>

        </HBox>
    </bottom>

</BorderPane>