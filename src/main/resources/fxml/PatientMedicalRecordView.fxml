<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.PatientMedicalRecordController">

    <top>

        <VBox spacing="8"
              styleClass="dashboard-content">

            <Label text="My Medical Records"
                   styleClass="section-title"/>

            <Label fx:id="patientLabel"
                   text="Patient: -"/>

        </VBox>

    </top>

    <center>

        <VBox spacing="12"
              styleClass="dashboard-content">

            <TableView fx:id="medicalRecordTable"
                       prefHeight="500">

                <columns>

                    <TableColumn fx:id="recordIdColumn"
                                 text="Record ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="doctorIdColumn"
                                 text="Doctor ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="appointmentIdColumn"
                                 text="Appointment ID"
                                 prefWidth="110"/>

                    <TableColumn fx:id="diagnosisColumn"
                                 text="Diagnosis"
                                 prefWidth="180"/>

                    <TableColumn fx:id="symptomsColumn"
                                 text="Symptoms"
                                 prefWidth="220"/>

                    <TableColumn fx:id="treatmentColumn"
                                 text="Treatment"
                                 prefWidth="220"/>

                    <TableColumn fx:id="notesColumn"
                                 text="Notes"
                                 prefWidth="220"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Created"
                                 prefWidth="150"/>

                </columns>

            </TableView>

            <HBox spacing="10">

                <Button text="Refresh"
                        onAction="#handleRefresh"/>

                <Button text="Close"
                        onAction="#handleClose"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>