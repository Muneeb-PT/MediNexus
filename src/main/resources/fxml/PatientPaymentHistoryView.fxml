<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.PatientPaymentHistoryController">

    <top>

        <VBox spacing="8"
              styleClass="dashboard-content">

            <Label text="Payment History"
                   styleClass="section-title"/>

            <Label text="View your previous payment transactions."/>

        </VBox>

    </top>


    <center>

        <VBox spacing="15"
              styleClass="dashboard-content">

            <TableView fx:id="paymentTable"
                       prefHeight="420"
                       prefWidth="1050"
                       columnResizePolicy="CONSTRAINED_RESIZE_POLICY">

                <columns>

                    <TableColumn fx:id="paymentIdColumn"
                                 text="Payment ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="billIdColumn"
                                 text="Bill ID"
                                 prefWidth="80"/>

                    <TableColumn fx:id="amountColumn"
                                 text="Amount"
                                 prefWidth="110"/>

                    <TableColumn fx:id="methodColumn"
                                 text="Payment Method"
                                 prefWidth="130"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="110"/>

                    <TableColumn fx:id="transactionIdColumn"
                                 text="Transaction ID"
                                 prefWidth="250"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="160"/>

                </columns>

            </TableView>


            <Label fx:id="messageLabel"
                   text="Loading payment history..."
                   wrapText="true"/>


            <HBox spacing="10">

                <Button fx:id="refreshButton"
                        text="Refresh"
                        onAction="#handleRefresh"/>

                <Button
                        fx:id="receiptButton"
                        text="Generate Receipt"
                        onAction="#handleGenerateReceipt"/>

                <Button fx:id="closeButton"
                        text="Close"
                        onAction="#handleClose"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>