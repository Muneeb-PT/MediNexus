<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.FeedbackController"
            style="-fx-background-color: #f5f7fb;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color: white;
                     -fx-border-color: #e1e5eb;
                     -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Button fx:id="backButton"
                    text="← Dashboard"
                    onAction="#handleBack"
                    style="-fx-background-color: #eef2f7;
                           -fx-text-fill: #263238;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-padding: 9 16;"/>

            <VBox spacing="3">
                <Label text="Feedback &amp; Complaints"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #17202a;"/>

                <Label text="Help us improve the MediNexus experience"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #667085;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox maxWidth="850"
              spacing="20">
            <padding>
                <Insets top="35" right="45" bottom="35" left="45"/>
            </padding>

            <Label text="Submit Feedback or Report an Issue"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #17202a;"/>

            <Label text="Provide clear information so the MediNexus support team can understand and address your request."
                   wrapText="true"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #667085;"/>

            <GridPane hgap="15"
                      vgap="15">

                <Label text="Type"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight: bold;"/>

                <ComboBox fx:id="typeComboBox"
                          prefWidth="300"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Category"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight: bold;"/>

                <ComboBox fx:id="categoryComboBox"
                          prefWidth="300"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Subject"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight: bold;"/>

                <TextField fx:id="subjectField"
                           prefWidth="500"
                           promptText="Enter a short subject"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

            </GridPane>

            <Label text="Description"
                   style="-fx-font-weight: bold;"/>

            <TextArea fx:id="messageArea"
                      prefRowCount="9"
                      wrapText="true"
                      promptText="Describe your feedback, complaint, problem, or suggestion..."
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-border-color: #d9dee7;
                             -fx-border-radius: 9;
                             -fx-background-radius: 9;"/>

            <HBox spacing="12"
                  alignment="CENTER_RIGHT">

                <Button text="Clear"
                        onAction="#handleClear"
                        style="-fx-background-color: #eef2f7;
                               -fx-text-fill: #344054;
                               -fx-background-radius: 8;
                               -fx-padding: 10 18;"/>

                <Button text="Submit"
                        onAction="#handleSubmit"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-padding: 10 22;"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Ready."
                   wrapText="true"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #667085;"/>

        </VBox>
    </center>

</BorderPane>