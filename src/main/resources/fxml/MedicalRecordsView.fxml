<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.MedicalRecordsController">

    <top>
        <VBox spacing="8" styleClass="dashboard-content">

            <Label text="Medical Records"
                   styleClass="section-title"/>

            <Label fx:id="patientLabel"
                   text="Patient: -"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="15"
              styleClass="dashboard-content">

            <TableView fx:id="recordTable"
                       prefHeight="450">

                <columns>

                    <TableColumn fx:id="recordIdColumn"
                                 text="Record ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="160"/>

                    <TableColumn fx:id="diagnosisColumn"
                                 text="Diagnosis"
                                 prefWidth="180"/>

                    <TableColumn fx:id="symptomsColumn"
                                 text="Symptoms"
                                 prefWidth="200"/>

                    <TableColumn fx:id="treatmentColumn"
                                 text="Treatment"
                                 prefWidth="200"/>

                    <TableColumn fx:id="notesColumn"
                                 text="Notes"
                                 prefWidth="220"/>

                </columns>

            </TableView>

            <HBox spacing="10">

                <Button text="Refresh"
                        onAction="#handleRefresh"/>

                <Button text="Add Medical Record"
                        onAction="#handleAddRecord"/>

                <Button text="Create E-Prescription"
                        onAction="#handleCreatePrescription"/>

                <Button text="View Prescriptions"
                        onAction="#handleViewPrescriptions"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>