<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.medinexus.controller.EmergencyController"
      spacing="12"
      styleClass="dashboard-content">

    <HBox alignment="CENTER_LEFT"
          spacing="15">

        <Label fx:id="titleLabel"
               text="Emergency Control Center"
               styleClass="section-title"/>

        <Button text="Refresh"
                onAction="#handleRefresh"/>

    </HBox>

    <Label fx:id="messageLabel"
           text=""
           styleClass="login-message"/>

    <VBox spacing="8"
          styleClass="triage-header">

        <Label text="Emergency Response"
               styleClass="triage-title"/>

        <Label text="Emergency requests are managed through controlled dispatch and vehicle status transitions."
               styleClass="triage-description"/>

    </VBox>

    <VBox spacing="8">

        <Label text="Request Emergency"
               styleClass="section-title"/>

        <HBox spacing="10">

            <TextField fx:id="emergencyTypeField"
                       promptText="Emergency type"
                       prefWidth="180"/>

            <ComboBox fx:id="severityComboBox"
                      promptText="Severity"
                      prefWidth="140"/>

            <TextField fx:id="pickupLocationField"
                       promptText="Pickup location"
                       prefWidth="220"/>

            <TextField fx:id="destinationField"
                       promptText="Destination"
                       prefWidth="220"/>

        </HBox>

        <TextArea fx:id="descriptionField"
                  promptText="Describe the emergency"
                  prefRowCount="2"
                  wrapText="true"/>

        <Button fx:id="requestButton"
                text="Request Emergency"
                onAction="#handleRequestEmergency"/>

    </VBox>

    <VBox spacing="8"
          VBox.vgrow="ALWAYS">

        <Label text="Emergency Requests"
               styleClass="section-title"/>

        <TableView fx:id="emergencyTable"
                   prefHeight="350"
                   VBox.vgrow="ALWAYS">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="65"/>

                <TableColumn fx:id="patientColumn"
                             text="Patient"
                             prefWidth="80"/>

                <TableColumn fx:id="typeColumn"
                             text="Emergency"
                             prefWidth="140"/>

                <TableColumn fx:id="severityColumn"
                             text="Severity"
                             prefWidth="100"/>

                <TableColumn fx:id="pickupColumn"
                             text="Pickup"
                             prefWidth="170"/>

                <TableColumn fx:id="destinationColumn"
                             text="Destination"
                             prefWidth="170"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="120"/>

                <TableColumn fx:id="vehicleColumn"
                             text="Vehicle"
                             prefWidth="100"/>

            </columns>

        </TableView>

    </VBox>

    <HBox spacing="10"
          alignment="CENTER_LEFT">

        <ComboBox fx:id="vehicleComboBox"
                  promptText="Available vehicle"
                  prefWidth="220"/>

        <Button fx:id="dispatchButton"
                text="Dispatch"
                onAction="#handleDispatch"
                disable="true"/>

        <Button fx:id="enRouteButton"
                text="Mark En Route"
                onAction="#handleEnRoute"
                disable="true"/>

        <Button fx:id="onSceneButton"
                text="Mark On Scene"
                onAction="#handleOnScene"
                disable="true"/>

        <Button fx:id="completeButton"
                text="Complete"
                onAction="#handleComplete"
                disable="true"/>
        <Button
                fx:id="returnVehicleButton"
                text="Return Vehicle"
                onAction="#handleReturnVehicle" />

        <Button fx:id="cancelButton"
                text="Cancel"
                onAction="#handleCancel"
                disable="true"/>

    </HBox>

</VBox>