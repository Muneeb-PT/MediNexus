<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.medinexus.controller.PatientProfileController"
      spacing="20"
      styleClass="dashboard-content">

    <Label text="My Profile"
           styleClass="section-title"/>

    <Label text="Personal Information"
           styleClass="section-title"/>

    <GridPane hgap="20"
              vgap="15">

        <Label text="Patient ID:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <Label fx:id="patientIdLabel"
               text="-"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1"/>

        <Label text="Name:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <Label fx:id="nameLabel"
               text="-"
               GridPane.rowIndex="1"
               GridPane.columnIndex="1"/>

        <Label text="Age:"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <Label fx:id="ageLabel"
               text="-"
               GridPane.rowIndex="2"
               GridPane.columnIndex="1"/>

        <Label text="Gender:"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <Label fx:id="genderLabel"
               text="-"
               GridPane.rowIndex="3"
               GridPane.columnIndex="1"/>

        <Label text="Phone:"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <Label fx:id="phoneLabel"
               text="-"
               GridPane.rowIndex="4"
               GridPane.columnIndex="1"/>

        <Label text="Blood Group:"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>

        <Label fx:id="bloodGroupLabel"
               text="-"
               GridPane.rowIndex="5"
               GridPane.columnIndex="1"/>

    </GridPane>

    <Label text="Identity Verification"
           styleClass="section-title"/>

    <HBox spacing="15">

        <Label fx:id="verificationStatusLabel"
               text="Identity Not Verified"/>

        <Button fx:id="verifyIdentityButton"
                text="Verify Identity"
                styleClass="login-button"
                onAction="#handleVerifyIdentity"/>

        <Button text="Verify with DigiLocker"
                onAction="#handleDigiLockerVerification"
                maxWidth="220.0"/>

    </HBox>

    <Label fx:id="identityStatusLabel"
           text="Identity verification status: Not verified"
           style="-fx-font-weight: bold;"/>

    <Label fx:id="messageLabel"
           text=""/>

</VBox>