<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.medinexus.controller.DoctorManagementController"
      spacing="15"
      styleClass="dashboard-content">

    <Label text="Doctor Management"
           styleClass="section-title"/>

    <Label text="Manage doctors, availability and doctor accounts."/>

    <HBox spacing="10">

        <Button fx:id="addButton"
                text="Add Doctor"
                onAction="#handleAddDoctor"/>

        <Button fx:id="editButton"
                text="Edit Selected"
                onAction="#handleEditDoctor"/>

        <Button fx:id="availabilityButton"
                text="Activate / Deactivate"
                onAction="#handleToggleAvailability"/>

        <Button fx:id="deleteButton"
                text="Delete Selected"
                onAction="#handleDeleteDoctor"/>

        <Button fx:id="refreshButton"
                text="Refresh"
                onAction="#handleRefresh"/>

    </HBox>

    <TableView fx:id="doctorTable"
               VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="idColumn"
                         text="ID"
                         prefWidth="70"/>

            <TableColumn fx:id="nameColumn"
                         text="Doctor Name"
                         prefWidth="180"/>

            <TableColumn fx:id="specializationColumn"
                         text="Specialization"
                         prefWidth="180"/>

            <TableColumn fx:id="phoneColumn"
                         text="Phone"
                         prefWidth="140"/>

            <TableColumn fx:id="emailColumn"
                         text="Email"
                         prefWidth="220"/>

            <TableColumn fx:id="availabilityColumn"
                         text="Available"
                         prefWidth="100"/>

        </columns>

    </TableView>

</VBox>