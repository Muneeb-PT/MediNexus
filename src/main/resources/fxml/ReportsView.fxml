<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.medinexus.controller.ReportsController"
        fitToWidth="true"
        fitToHeight="true">

    <content>

        <VBox spacing="20">

            <padding>
                <Insets top="25" right="30" bottom="30" left="30"/>
            </padding>

            <!-- HEADER -->

            <HBox spacing="15" alignment="CENTER_LEFT">

                <VBox HBox.hgrow="ALWAYS">

                    <Label
                            text="MediNexus Reports"
                            style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

                    <Label
                            text="Hospital management statistics and financial overview"
                            style="-fx-font-size: 14px;"/>

                </VBox>

                <Button
                        text="Refresh"
                        onAction="#handleRefresh"
                        style="-fx-padding: 8 18 8 18;"/>

            </HBox>


            <!-- HOSPITAL OVERVIEW -->

            <Label
                    text="Hospital Overview"
                    style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="15">

                <VBox
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 20; -fx-background-color: #E8F1FF; -fx-background-radius: 10;">

                    <Label text="Total Patients"/>

                    <Label
                            fx:id="totalPatientsLabel"
                            text="0"
                            style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 20; -fx-background-color: #EAF8EF; -fx-background-radius: 10;">

                    <Label text="Total Doctors"/>

                    <Label
                            fx:id="totalDoctorsLabel"
                            text="0"
                            style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 20; -fx-background-color: #FFF4DD; -fx-background-radius: 10;">

                    <Label text="Appointments"/>

                    <Label
                            fx:id="totalAppointmentsLabel"
                            text="0"
                            style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 20; -fx-background-color: #F3EAFE; -fx-background-radius: 10;">

                    <Label text="Medicines"/>

                    <Label
                            fx:id="totalMedicinesLabel"
                            text="0"
                            style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

                </VBox>

            </GridPane>


            <!-- APPOINTMENT STATISTICS -->

            <Label
                    text="Appointment Statistics"
                    style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="15">

                <VBox
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #F5F5F5; -fx-background-radius: 10;">

                    <Label text="Scheduled"/>

                    <Label
                            fx:id="scheduledAppointmentsLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #F5F5F5; -fx-background-radius: 10;">

                    <Label text="Completed"/>

                    <Label
                            fx:id="completedAppointmentsLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #F5F5F5; -fx-background-radius: 10;">

                    <Label text="Cancelled"/>

                    <Label
                            fx:id="cancelledAppointmentsLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>

            </GridPane>


            <!-- FINANCIAL SUMMARY -->

            <Label
                    text="Financial Summary"
                    style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="15">

                <VBox
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 20; -fx-background-color: #EAF8EF; -fx-background-radius: 10;">

                    <Label text="Total Billed"/>

                    <Label
                            fx:id="totalBilledLabel"
                            text="₹ 0.00"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 20; -fx-background-color: #E8F1FF; -fx-background-radius: 10;">

                    <Label text="Total Paid"/>

                    <Label
                            fx:id="totalPaidLabel"
                            text="₹ 0.00"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 20; -fx-background-color: #FFF4DD; -fx-background-radius: 10;">

                    <Label text="Pending Amount"/>

                    <Label
                            fx:id="totalPendingLabel"
                            text="₹ 0.00"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>

            </GridPane>


            <!-- PRESCRIPTION STATISTICS -->

            <Label
                    text="Prescription Statistics"
                    style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="15">

                <VBox
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #F5F5F5; -fx-background-radius: 10;">

                    <Label text="Total"/>

                    <Label
                            fx:id="totalPrescriptionsLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #F5F5F5; -fx-background-radius: 10;">

                    <Label text="Pending"/>

                    <Label
                            fx:id="pendingPrescriptionsLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #F5F5F5; -fx-background-radius: 10;">

                    <Label text="Dispensed"/>

                    <Label
                            fx:id="dispensedPrescriptionsLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #F5F5F5; -fx-background-radius: 10;">

                    <Label text="Billed"/>

                    <Label
                            fx:id="billedPrescriptionsLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="4"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #F5F5F5; -fx-background-radius: 10;">

                    <Label text="Paid"/>

                    <Label
                            fx:id="paidPrescriptionsLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>

            </GridPane>


            <!-- MEDICINE INVENTORY -->

            <Label
                    text="Medicine Inventory"
                    style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="15" vgap="15">

                <VBox
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #F5F5F5; -fx-background-radius: 10;">

                    <Label text="Available Medicines"/>

                    <Label
                            fx:id="availableMedicinesLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>


                <VBox
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"
                        spacing="8"
                        style="-fx-padding: 18; -fx-background-color: #FFECEC; -fx-background-radius: 10;">

                    <Label text="Out of Stock"/>

                    <Label
                            fx:id="outOfStockMedicinesLabel"
                            text="0"
                            style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                </VBox>

            </GridPane>

        </VBox>

    </content>

</ScrollPane>