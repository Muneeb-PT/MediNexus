<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.medinexus.controller.LoginController"
           stylesheets="@../css/style.css">

    <VBox alignment="CENTER"
          spacing="15"
          maxWidth="380">

        <ImageView fitHeight="90"
                   fitWidth="90"
                   preserveRatio="true">

            <image>
                <Image url="@../images/logo.png"/>
            </image>

        </ImageView>

        <Label text="Welcome Back"
               styleClass="login-title"/>

        <Label text="Sign in to MediNexus"
               styleClass="login-subtitle"/>

        <TextField fx:id="usernameField"
                   promptText="Username"
                   prefHeight="45"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       prefHeight="45"/>

        <ComboBox fx:id="roleComboBox"
                  promptText="Select Role"
                  prefHeight="45"
                  prefWidth="380"/>

        <Button text="LOGIN"
                fx:id="loginButton"
                onAction="#handleLogin"
                prefWidth="380"
                prefHeight="45"
                styleClass="login-button"/>
        <Button text="Create Patient Account"
                onAction="#handleOpenSignup"
                style="-fx-background-color: transparent;
               -fx-text-fill: #2563eb;
               -fx-font-weight: bold;"/>
        <Button text="Forgot Password?"
                onAction="#handleForgotPassword"
                style="-fx-background-color: transparent;
               -fx-text-fill: #2563eb;
               -fx-font-weight: bold;"/>

        <Label fx:id="messageLabel"
               text=""
               styleClass="login-message"/>

        <Label text="MediNexus • Smart Hospital Management System"
               styleClass="login-footer"/>

    </VBox>

</StackPane>