<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.effect.ColorAdjust?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.medinexus.controller.LoginController"
           stylesheets="@../css/style.css"
           styleClass="login-root">

    <!-- Full-screen campus background -->

    <ImageView fx:id="backgroundImage"
               fitWidth="1440"
               fitHeight="900"
               preserveRatio="false"
               mouseTransparent="true">
        <image>
            <Image url="@../images/bg.png"
                   backgroundLoading="true"/>
        </image>
        <effect>
            <GaussianBlur radius="9"/>
        </effect>
    </ImageView>


    <!-- Dark translucent overlay -->
    <Region styleClass="login-overlay"
            mouseTransparent="true"/>

    <!-- Main login panel -->
    <VBox alignment="CENTER"
          spacing="17"
          maxWidth="600"
          prefWidth="600"
          styleClass="login-card">

        <ImageView fitWidth="100"
                   fitHeight="100"
                   preserveRatio="true">
            <image>
                <Image url="@../images/logo.png"/>
            </image>
        </ImageView>

        <Label text="MediNexus"
               styleClass="login-brand"/>

        <Label text="SMART HOSPITAL MANAGEMENT"
               styleClass="login-eyebrow"/>

        <VBox alignment="CENTER" spacing="5">
            <Label text="Welcome back"
                   styleClass="login-title"/>

            <Label text="Sign in to continue to your healthcare workspace."
                   wrapText="true"
                   styleClass="login-subtitle"/>
        </VBox>

        <VBox spacing="7" styleClass="login-field-group">
            <Label text="Username"
                   styleClass="login-field-label"/>

            <TextField fx:id="usernameField"
                       promptText="Enter your username"
                       prefHeight="46"
                       styleClass="login-input"/>
        </VBox>

        <VBox spacing="7" styleClass="login-field-group">
            <Label text="Password"
                   styleClass="login-field-label"/>

            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           prefHeight="46"
                           styleClass="login-input"/>
        </VBox>

        <VBox spacing="7" styleClass="login-field-group">
            <Label text="Sign in as"
                   styleClass="login-field-label"/>

            <ComboBox fx:id="roleComboBox"
                      promptText="Select your role"
                      prefHeight="46"
                      maxWidth="Infinity"
                      styleClass="login-input"/>
        </VBox>

        <Button fx:id="loginButton"
                text="SIGN IN"
                onAction="#handleLogin"
                prefHeight="48"
                maxWidth="Infinity"
                styleClass="login-button"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="New to MediNexus?"
                   styleClass="login-link-caption"/>

            <Button text="Create account"
                    onAction="#handleOpenSignup"
                    styleClass="login-text-button"/>
        </HBox>

        <Button text="Forgot your password?"
                onAction="#handleForgotPassword"
                styleClass="login-text-button"/>

        <Label fx:id="messageLabel"
               text=""
               wrapText="true"
               styleClass="login-message"/>

        <VBox alignment="CENTER" spacing="4">
            <Region styleClass="login-divider"/>
            <Label text="SECURE ACCESS • SMARTER HEALTHCARE"
                   styleClass="login-footer"/>
        </VBox>

    </VBox>

</StackPane>
