<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.PatientPrescriptionController">

    <top>
        <VBox spacing="8"
              styleClass="dashboard-content">

            <Label text="My Prescriptions"
                   styleClass="section-title"/>

            <Label text="View prescriptions issued by your doctor."/>

        </VBox>
    </top>

    <center>
        <VBox spacing="15"
              styleClass="dashboard-content">

            <TableView fx:id="prescriptionTable"
                       prefHeight="450">

                <columns>

                    <TableColumn fx:id="prescriptionIdColumn"
                                 text="Prescription ID"
                                 prefWidth="110"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="145"/>

                    <TableColumn fx:id="medicalRecordColumn"
                                 text="Record ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="medicineColumn"
                                 text="Medicine ID"
                                 prefWidth="100"/>

                    <TableColumn fx:id="quantityColumn"
                                 text="Quantity"
                                 prefWidth="80"/>

                    <TableColumn fx:id="dosageColumn"
                                 text="Dosage"
                                 prefWidth="120"/>

                    <TableColumn fx:id="frequencyColumn"
                                 text="Frequency"
                                 prefWidth="120"/>

                    <TableColumn fx:id="durationColumn"
                                 text="Duration"
                                 prefWidth="110"/>

                    <TableColumn fx:id="instructionsColumn"
                                 text="Instructions"
                                 prefWidth="200"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="110"/>

                </columns>

            </TableView>

            <Label fx:id="messageLabel"
                   text="Loading prescriptions..."
                   wrapText="true"/>

            <HBox spacing="10">

                <Button fx:id="refreshButton"
                        text="Refresh"
                        onAction="#handleRefresh"/>

                <Button text="Close"
                        onAction="#handleClose"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>