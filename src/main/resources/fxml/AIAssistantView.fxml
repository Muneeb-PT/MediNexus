<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.AIAssistantController"
            style="-fx-background-color: #f5f7fb;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color: white;
                     -fx-border-color: #e1e5eb;
                     -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Button fx:id="backButton"
                    text="← Dashboard"
                    onAction="#handleBack"
                    style="-fx-background-color: #eef2f7;
                           -fx-text-fill: #263238;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-padding: 9 16;"/>

            <VBox spacing="3">
                <Label text="MediNexus AI Assistant"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #17202a;"/>

                <Label fx:id="statusLabel"
                       text="Assistant ready"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #667085;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="25" right="35" bottom="20" left="35"/>
            </padding>

            <TextArea fx:id="chatArea"
                      VBox.vgrow="ALWAYS"
                      wrapText="true"
                      editable="false"
                      style="-fx-control-inner-background: white;
                             -fx-background-color: white;
                             -fx-border-color: #d9dee7;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;
                             -fx-font-size: 14px;
                             -fx-padding: 15;"/>

            <HBox spacing="10">

                <TextField fx:id="messageField"
                           HBox.hgrow="ALWAYS"
                           promptText="Ask MediNexus AI..."
                           onAction="#handleSend"
                           style="-fx-background-color: white;
                                  -fx-border-color: #d9dee7;
                                  -fx-border-radius: 9;
                                  -fx-background-radius: 9;
                                  -fx-padding: 12;
                                  -fx-font-size: 14px;"/>

                <Button fx:id="sendButton"
                        text="Send"
                        onAction="#handleSend"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 9;
                               -fx-padding: 12 22;"/>

            </HBox>

            <Label text="MediNexus AI provides system assistance. It is not a substitute for professional medical advice."
                   wrapText="true"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #98a2b3;"/>

        </VBox>
    </center>

</BorderPane>