<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.BillingController">

    <top>

        <VBox spacing="8"
              styleClass="dashboard-content">

            <Label text="Billing &amp; Payments"
                   styleClass="section-title"/>

            <Label text="View your bills and payment status."/>

        </VBox>

    </top>

    <center>

        <VBox spacing="12"
              styleClass="dashboard-content">

            <TableView fx:id="billingTable"
                       prefHeight="500">

                <columns>

                    <TableColumn fx:id="billIdColumn"
                                 text="Bill ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="patientIdColumn"
                                 text="Patient ID"
                                 prefWidth="100"/>

                    <TableColumn fx:id="appointmentIdColumn"
                                 text="Appointment ID"
                                 prefWidth="120"/>

                    <TableColumn fx:id="consultationColumn"
                                 text="Consultation"
                                 prefWidth="120"/>

                    <TableColumn fx:id="medicineColumn"
                                 text="Medicine"
                                 prefWidth="110"/>

                    <TableColumn fx:id="otherChargesColumn"
                                 text="Other"
                                 prefWidth="100"/>

                    <TableColumn fx:id="totalColumn"
                                 text="Total"
                                 prefWidth="110"/>

                    <TableColumn fx:id="paymentStatusColumn"
                                 text="Payment Status"
                                 prefWidth="130"/>

                </columns>

            </TableView>

            <HBox spacing="10">

                <Button text="Refresh"
                        onAction="#handleRefresh"/>

                <Button text="Pay Online"
                        onAction="#handlePayOnline"/>

                <Button text="Mark Cash Paid"
                        onAction="#handleMarkPaid"/>

                <Button text="Close"
                        onAction="#handleClose"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>