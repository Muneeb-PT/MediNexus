<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.DashboardController"
            stylesheets="@../css/style.css">

    <!-- =========================================================
         SIDEBAR
         ========================================================= -->

    <left>
        <BorderPane prefWidth="235"
                    styleClass="sidebar-container">

            <!-- Scrollable navigation -->
            <center>
                <ScrollPane fitToWidth="true"
                            fitToHeight="false"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            pannable="true"
                            styleClass="sidebar-scroll-pane">

                    <content>
                        <VBox spacing="8"
                              fillWidth="true"
                              styleClass="sidebar-navigation">

                            <!-- Dashboard -->
                            <Button fx:id="dashboardButton"
                                    text="⌂  Dashboard"
                                    onAction="#handleDashboard"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Notifications -->
                            <Button fx:id="notificationsButton"
                                    text="🔔  Notifications"
                                    onAction="#handleNotifications"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Patients -->
                            <Button fx:id="patientsButton"
                                    text="👤  Patients"
                                    onAction="#handlePatients"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Doctors -->
                            <Button fx:id="doctorsButton"
                                    text="🩺  Doctors"
                                    onAction="#handleDoctors"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Appointments -->
                            <Button fx:id="appointmentsButton"
                                    text="📅  Appointments"
                                    onAction="#handleAppointments"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Medicines -->
                            <Button fx:id="medicinesButton"
                                    text="💊  Medicines"
                                    onAction="#handleMedicines"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Billing -->
                            <Button fx:id="billingButton"
                                    text="💳  Billing"
                                    onAction="#handleBilling"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Reports -->
                            <Button fx:id="reportsButton"
                                    text="📊  Reports"
                                    onAction="#handleReports"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Profile -->
                            <Button fx:id="profileButton"
                                    text="👤  My Profile"
                                    onAction="#handleProfile"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Medical Records -->
                            <Button fx:id="medicalRecordsButton"
                                    text="📋  Medical Records"
                                    onAction="#handleMedicalRecords"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Prescriptions -->
                            <Button fx:id="prescriptionsButton"
                                    text="💊  Prescriptions"
                                    onAction="#handlePrescriptions"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Payment History -->
                            <Button fx:id="paymentHistoryButton"
                                    text="💰  Payment History"
                                    onAction="#handlePaymentHistory"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Online Payment -->
                            <Button fx:id="onlinePaymentButton"
                                    text="💳  Online Payment"
                                    onAction="#handleOnlinePayment"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Identity Verification -->
                            <Button fx:id="identityButton"
                                    text="🪪  Identity Verification"
                                    onAction="#handleIdentity"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Emergency -->
                            <Button fx:id="emergencyButton"
                                    text="🚑  Emergency"
                                    onAction="#handleEmergency"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Help -->
                            <Button fx:id="helpButton"
                                    text="❓  Help Center"
                                    onAction="#handleHelp"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- AI Assistant -->
                            <Button fx:id="aiAssistantButton"
                                    text="🤖  AI Assistant"
                                    onAction="#handleAIAssistant"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                            <!-- Feedback / Support -->
                            <Button fx:id="supportTicketsButton"
                                    text="🎫  Feedback &amp; Support"
                                    onAction="#handleSupportTickets"
                                    maxWidth="Infinity"
                                    styleClass="sidebar-button"/>

                        </VBox>
                    </content>
                </ScrollPane>
            </center>

            <!-- Fixed bottom controls -->
            <bottom>
                <VBox spacing="8"
                      styleClass="sidebar-bottom">

                    <Separator/>

                    <Button fx:id="settingsButton"
                            text="⚙  Settings"
                            onAction="#handleSettings"
                            maxWidth="Infinity"
                            styleClass="sidebar-button"/>

                    <Button fx:id="logoutButton"
                            text="↪  Sign Out"
                            onAction="#handleLogout"
                            maxWidth="Infinity"
                            styleClass="sidebar-button"/>

                </VBox>
            </bottom>

        </BorderPane>
    </left>


    <!-- =========================================================
         TOP BAR
         ========================================================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              spacing="12"
              styleClass="topbar">

            <Button text="← Dashboard"
                    onAction="#handleBackToDashboard"
                    styleClass="back-button"/>

            <VBox spacing="2">

                <Label text="MediNexus"
                       styleClass="page-title"/>

                <Label text="Smart Hospital Management System"
                       styleClass="topbar-subtitle"/>

            </VBox>

            <VBox HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel"
                   text="User"
                   styleClass="user-label"/>

        </HBox>

    </top>


    <!-- =========================================================
         MAIN DASHBOARD - SCROLLABLE
         ========================================================= -->

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="true"
                    styleClass="dashboard-scroll-pane">

            <content>

                <VBox fx:id="contentArea"
                      spacing="18"
                      fillWidth="true"
                      styleClass="dashboard-content">

                    <!-- =================================================
                         GREETING
                         ================================================= -->

                    <VBox spacing="4">

                        <Label fx:id="dashboardGreetingLabel"
                               text="Welcome back"
                               styleClass="dashboard-greeting"/>

                        <Label fx:id="dashboardSubtitleLabel"
                               text="Hospital management overview"
                               styleClass="dashboard-subtitle"/>

                    </VBox>


                    <!-- =================================================
                         STATISTICS
                         ================================================= -->

                    <HBox spacing="14"
                          fillHeight="true">

                        <VBox styleClass="dashboard-stat-card">

                            <Label text="PATIENTS"
                                   styleClass="dashboard-stat-title"/>

                            <Label fx:id="patientCountLabel"
                                   text="--"
                                   styleClass="dashboard-stat-value"/>

                        </VBox>


                        <VBox styleClass="dashboard-stat-card">

                            <Label text="DOCTORS"
                                   styleClass="dashboard-stat-title"/>

                            <Label fx:id="doctorCountLabel"
                                   text="--"
                                   styleClass="dashboard-stat-value"/>

                        </VBox>


                        <VBox styleClass="dashboard-stat-card">

                            <Label text="APPOINTMENTS"
                                   styleClass="dashboard-stat-title"/>

                            <Label fx:id="appointmentCountLabel"
                                   text="--"
                                   styleClass="dashboard-stat-value"/>

                        </VBox>


                        <VBox styleClass="dashboard-stat-card">

                            <Label text="MEDICINES"
                                   styleClass="dashboard-stat-title"/>

                            <Label fx:id="medicineCountLabel"
                                   text="--"
                                   styleClass="dashboard-stat-value"/>

                        </VBox>

                    </HBox>


                    <!-- =================================================
                         QUICK SERVICES
                         ================================================= -->

                    <Label text="Quick Services"
                           styleClass="section-title"/>


                    <GridPane hgap="12"
                              vgap="12">

                        <Button fx:id="quickAppointmentButton"
                                text="Appointments&#10;Manage appointments"
                                onAction="#handleQuickAppointment"
                                styleClass="quick-service-button"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0"/>

                        <Button fx:id="quickRecordsButton"
                                text="Medical Records&#10;View patient records"
                                onAction="#handleQuickRecords"
                                styleClass="quick-service-button"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0"/>

                        <Button fx:id="quickPrescriptionButton"
                                text="Prescriptions&#10;Manage prescriptions"
                                onAction="#handleQuickPrescription"
                                styleClass="quick-service-button"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="0"/>

                        <Button fx:id="quickBillingButton"
                                text="Billing &amp; Payments&#10;View financial services"
                                onAction="#handleQuickBilling"
                                styleClass="quick-service-button"
                                GridPane.columnIndex="3"
                                GridPane.rowIndex="0"/>

                        <Button fx:id="quickNotificationsButton"
                                text="Notifications&#10;View recent alerts"
                                onAction="#handleQuickNotifications"
                                styleClass="quick-service-button"
                                GridPane.columnIndex="4"
                                GridPane.rowIndex="0"/>

                        <Button fx:id="quickInventoryButton"
                                text="Medicine Inventory&#10;Manage stock"
                                onAction="#handleQuickInventory"
                                styleClass="quick-service-button"
                                GridPane.columnIndex="5"
                                GridPane.rowIndex="0"/>

                    </GridPane>


                    <!-- =================================================
                         RECENT APPOINTMENTS
                         ================================================= -->

                    <HBox alignment="CENTER_LEFT"
                          spacing="12">

                        <Label text="Recent Appointments"
                               styleClass="section-title"/>

                        <VBox HBox.hgrow="ALWAYS"/>

                        <Label fx:id="dashboardStatusLabel"
                               text="System data loaded"
                               styleClass="dashboard-status"/>

                    </HBox>


                    <TableView fx:id="recentAppointmentsTable"
                               prefHeight="220"
                               minHeight="220"
                               styleClass="dashboard-table">

                        <columns>

                            <TableColumn fx:id="recentAppointmentIdColumn"
                                         text="ID"
                                         prefWidth="75"/>

                            <TableColumn fx:id="recentPatientColumn"
                                         text="Patient"
                                         prefWidth="85"/>

                            <TableColumn fx:id="recentDoctorColumn"
                                         text="Doctor"
                                         prefWidth="85"/>

                            <TableColumn fx:id="recentDateColumn"
                                         text="Date"
                                         prefWidth="110"/>

                            <TableColumn fx:id="recentTimeColumn"
                                         text="Time"
                                         prefWidth="100"/>

                            <TableColumn fx:id="recentUrgencyColumn"
                                         text="Priority"
                                         prefWidth="100"/>

                            <TableColumn fx:id="recentStatusColumn"
                                         text="Status"
                                         prefWidth="110"/>

                        </columns>

                        <placeholder>

                            <Label text="No appointments available"
                                   styleClass="empty-message"/>

                        </placeholder>

                    </TableView>


                    <!-- =================================================
                         MEDICINE INVENTORY
                         ================================================= -->

                    <Label text="Medicine Inventory"
                           styleClass="section-title"/>


                    <HBox spacing="12">

                        <VBox styleClass="inventory-card">

                            <Label text="Total Medicines"
                                   styleClass="inventory-title"/>

                            <Label fx:id="medicineInventoryTotalLabel"
                                   text="--"
                                   styleClass="inventory-value"/>

                        </VBox>


                        <VBox styleClass="inventory-card warning-card">

                            <Label text="Low Stock"
                                   styleClass="inventory-title"/>

                            <Label fx:id="lowStockCountLabel"
                                   text="--"
                                   styleClass="inventory-value"/>

                        </VBox>


                        <VBox styleClass="inventory-card danger-card">

                            <Label text="Out of Stock"
                                   styleClass="inventory-title"/>

                            <Label fx:id="outOfStockCountLabel"
                                   text="--"
                                   styleClass="inventory-value"/>

                        </VBox>

                    </HBox>


                    <!-- Bottom spacing -->

                    <VBox minHeight="30"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>