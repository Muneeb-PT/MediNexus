<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.NotificationController">

    <top>
        <VBox spacing="5">
            <padding>
                <Insets top="20"
                        right="20"
                        bottom="15"
                        left="20"/>
            </padding>

            <Label text="🔔 Notifications"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="View and manage your MediNexus notifications."
                   style="-fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="notificationTable"
                   onMouseClicked="#handleNotificationSelection">

            <columns>

                <TableColumn fx:id="typeColumn"
                             text="Type"
                             prefWidth="140"/>

                <TableColumn fx:id="messageColumn"
                             text="Message"
                             prefWidth="430"/>

                <TableColumn fx:id="dateColumn"
                             text="Date &amp; Time"
                             prefWidth="180"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="110"/>

            </columns>

        </TableView>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="15"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Button text="Refresh"
                    onAction="#handleRefresh"/>

            <Button fx:id="markReadButton"
                    text="Mark as Read"
                    disable="true"
                    onAction="#handleMarkAsRead"/>

            <Button text="Mark All as Read"
                    onAction="#handleMarkAllAsRead"/>
        </HBox>
    </bottom>

</BorderPane>