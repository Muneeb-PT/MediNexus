<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.SplitPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medinexus.controller.SupportTicketManagementController"
            style="-fx-background-color: #f5f7fb;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: white; -fx-border-color: #e1e5eb; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="16" right="22" bottom="16" left="22"/>
            </padding>
            <Button fx:id="backButton"
                    text="← Dashboard"
                    onAction="#handleBack"
                    style="-fx-background-color: #eef2f7; -fx-text-fill: #263238; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 16;"/>
            <VBox spacing="3">
                <Label text="Feedback &amp; Support"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #17202a;"/>
                <Label text="Review requests, update ticket status, and assign support staff"
                       style="-fx-font-size: 12px; -fx-text-fill: #667085;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="22" bottom="20" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4">
                    <Label text="Support Tickets"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #17202a;"/>
                    <Label text="Select a ticket to inspect its details and manage it."
                           style="-fx-text-fill: #667085;"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="refreshButton"
                        text="Refresh"
                        onAction="#handleRefresh"
                        style="-fx-background-color: #19A7A8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 9 18;"/>
            </HBox>

            <GridPane hgap="10" vgap="6">
                <Label text="Status filter" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-font-weight: bold; -fx-text-fill: #344054;"/>
                <ComboBox fx:id="statusFilterComboBox" prefWidth="180"
                          GridPane.columnIndex="0" GridPane.rowIndex="1"
                          onAction="#handleFilter"/>
                <Label text="Priority filter" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       style="-fx-font-weight: bold; -fx-text-fill: #344054;"/>
                <ComboBox fx:id="priorityFilterComboBox" prefWidth="180"
                          GridPane.columnIndex="1" GridPane.rowIndex="1"
                          onAction="#handleFilter"/>
            </GridPane>

            <SplitPane dividerPositions="0.68" VBox.vgrow="ALWAYS">
                <items>
                    <VBox spacing="8">
                        <TableView fx:id="ticketTable" VBox.vgrow="ALWAYS"
                                   columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                            <columns>
                                <TableColumn fx:id="ticketIdColumn" text="Ticket #" prefWidth="70"/>
                                <TableColumn fx:id="userIdColumn" text="User ID" prefWidth="70"/>
                                <TableColumn fx:id="typeColumn" text="Type" prefWidth="100"/>
                                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="130"/>
                                <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="160"/>
                                <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="85"/>
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                                <TableColumn fx:id="assignedToColumn" text="Assigned To" prefWidth="100"/>
                                <TableColumn fx:id="createdAtColumn" text="Created" prefWidth="125"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox spacing="12" minWidth="250"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e1e5eb; -fx-border-radius: 10;">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <Label text="Ticket Details"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #17202a;"/>
                        <Label fx:id="detailsLabel"
                               text="Select a ticket to view its details."
                               wrapText="true"
                               maxWidth="Infinity"
                               VBox.vgrow="ALWAYS"
                               style="-fx-text-fill: #475467; -fx-padding: 8 0 8 0;"/>
                        <Label text="Update status"
                               style="-fx-font-weight: bold; -fx-text-fill: #344054;"/>
                        <ComboBox fx:id="statusComboBox" maxWidth="Infinity"
                                  promptText="Choose status"/>
                        <Button fx:id="updateStatusButton"
                                text="Update Status"
                                onAction="#handleUpdateStatus"
                                maxWidth="Infinity"
                                style="-fx-background-color: #19A7A8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 9 12;"/>
                        <Label text="Assign support staff"
                               style="-fx-font-weight: bold; -fx-text-fill: #344054;"/>
                        <ComboBox fx:id="assignedToComboBox" maxWidth="Infinity"
                                  promptText="Choose staff member"/>
                        <Button fx:id="assignButton"
                                text="Assign Ticket"
                                onAction="#handleAssign"
                                maxWidth="Infinity"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-padding: 9 12;"/>
                    </VBox>
                </items>
            </SplitPane>

            <Label fx:id="messageLabel"
                   text="Ready."
                   wrapText="true"
                   style="-fx-text-fill: #667085; -fx-padding: 4 0 0 0;"/>
        </VBox>
    </center>
</BorderPane>
