<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.medinexus.controller.SupportTicketManagementController">

    <top>
        <VBox spacing="6"
              style="-fx-background-color: #17324D;">

            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <Label
                    text="Support Ticket Management"
                    style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label
                    text="Manage feedback, complaints and support requests"
                    style="-fx-text-fill: #D8E6F2; -fx-font-size: 13px;"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="14">

            <padding>
                <Insets top="18" right="20" bottom="18" left="20"/>
            </padding>

            <!-- Filters -->
            <HBox spacing="10">

                <Label
                        text="Status:"
                        style="-fx-font-weight: bold;"
                        alignment="CENTER_LEFT"/>

                <ComboBox
                        fx:id="statusFilterComboBox"
                        prefWidth="150"/>

                <Label
                        text="Priority:"
                        style="-fx-font-weight: bold;"
                        alignment="CENTER_LEFT"/>

                <ComboBox
                        fx:id="priorityFilterComboBox"
                        prefWidth="150"/>

                <Button
                        text="Apply Filter"
                        onAction="#handleFilter"/>

                <Button
                        fx:id="refreshButton"
                        text="Refresh"
                        onAction="#handleRefresh"/>

            </HBox>

            <!-- Ticket table -->
            <TableView
                    fx:id="ticketTable"
                    VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn
                            fx:id="ticketIdColumn"
                            text="ID"
                            prefWidth="65"/>

                    <TableColumn
                            fx:id="userIdColumn"
                            text="User ID"
                            prefWidth="75"/>

                    <TableColumn
                            fx:id="typeColumn"
                            text="Type"
                            prefWidth="120"/>

                    <TableColumn
                            fx:id="categoryColumn"
                            text="Category"
                            prefWidth="140"/>

                    <TableColumn
                            fx:id="subjectColumn"
                            text="Subject"
                            prefWidth="220"/>

                    <TableColumn
                            fx:id="priorityColumn"
                            text="Priority"
                            prefWidth="90"/>

                    <TableColumn
                            fx:id="statusColumn"
                            text="Status"
                            prefWidth="110"/>

                    <TableColumn
                            fx:id="assignedToColumn"
                            text="Assigned To"
                            prefWidth="100"/>

                    <TableColumn
                            fx:id="createdAtColumn"
                            text="Created"
                            prefWidth="140"/>

                </columns>

            </TableView>

            <!-- Details -->
            <TitledPane
                    text="Ticket Details"
                    expanded="true">

                <content>

                    <VBox
                            fx:id="detailsBox"
                            spacing="8">

                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>

                        <Label
                                fx:id="detailsLabel"
                                text="Select a ticket to view its details."
                                wrapText="true"
                                maxWidth="900"/>

                    </VBox>

                </content>

            </TitledPane>

            <!-- Actions -->
            <HBox
                    spacing="10"
                    alignment="CENTER_LEFT">

                <Label
                        text="Status:"
                        style="-fx-font-weight: bold;"/>

                <ComboBox
                        fx:id="statusComboBox"
                        prefWidth="150"/>

                <Button
                        fx:id="updateStatusButton"
                        text="Update Status"
                        onAction="#handleUpdateStatus"/>

                <Label
                        text="Assign To:"
                        style="-fx-font-weight: bold;"/>

                <ComboBox
                        fx:id="assignedToComboBox"
                        prefWidth="150"/>

                <Button
                        fx:id="assignButton"
                        text="Assign Ticket"
                        onAction="#handleAssign"/>

            </HBox>

            <HBox
                    spacing="10"
                    alignment="CENTER_LEFT">

                <Label
                        fx:id="messageLabel"
                        text="Ready."
                        style="-fx-text-fill: #555555;"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="backButton"
                        text="Back to Dashboard"
                        onAction="#handleBack"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>